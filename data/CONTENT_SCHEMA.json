{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quiz Studio Question",
  "description": "Canonical question shape for scalable content ops. Prefer string IDs with subject prefixes (MATH-P3-ADD-001).",
  "type": "object",
  "required": ["id", "category", "difficulty", "template", "options", "answer"],
  "properties": {
    "id": {
      "oneOf": [{ "type": "string" }, { "type": "number" }],
      "description": "Prefer globally unique string IDs going forward."
    },
    "subject": {
      "type": "string",
      "enum": ["math", "science", "english", "chinese"]
    },
    "category": { "type": "string" },
    "difficulty": { "type": "string" },
    "template": { "type": "string" },
    "options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": { "type": "string" }
    },
    "answer": { "type": "integer", "minimum": 0 },
    "correct_answer": { "type": "string" },
    "explanation": { "type": "string" },
    "skills": {
      "type": "array",
      "items": { "type": "string" }
    },
    "placeholder_roles": {
      "type": "array",
      "items": { "type": "string" }
    },
    "diagram": { "type": "string" },
    "experiment_setup": { "type": "string" },
    "experiment_data": { "type": "string" }
  }
}
