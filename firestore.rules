rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validVelocityProgressData(data) {
      return data.keys().hasOnly(['money', 'bestDistance', 'playerBrand', 'upgrades', 'updatedAt', 'reason'])
        && data.money is int && data.money >= 0 && data.money <= 500000
        && data.bestDistance is int && data.bestDistance >= 0 && data.bestDistance <= 50000
        && data.playerBrand in ['falcon', 'nova', 'apex']
        && data.reason is string && data.reason.size() <= 32
        && data.updatedAt is timestamp
        && data.upgrades is map
        && data.upgrades.keys().hasOnly(['engine', 'handling', 'armor'])
        && data.upgrades.engine is int && data.upgrades.engine >= 0 && data.upgrades.engine <= 3
        && data.upgrades.handling is int && data.upgrades.handling >= 0 && data.upgrades.handling <= 3
        && data.upgrades.armor is int && data.upgrades.armor >= 0 && data.upgrades.armor <= 3;
    }

    function validVelocityProgressTransition(nextData, previousData) {
      let engineCost = previousData.upgrades.engine == 0 ? 300
        : previousData.upgrades.engine == 1 ? 520
        : previousData.upgrades.engine == 2 ? 760
        : 999999;
      let handlingCost = previousData.upgrades.handling == 0 ? 240
        : previousData.upgrades.handling == 1 ? 420
        : previousData.upgrades.handling == 2 ? 640
        : 999999;
      let armorCost = previousData.upgrades.armor == 0 ? 260
        : previousData.upgrades.armor == 1 ? 460
        : previousData.upgrades.armor == 2 ? 690
        : 999999;
      let requiredSpend =
        (nextData.upgrades.engine == previousData.upgrades.engine ? 0 : engineCost) +
        (nextData.upgrades.handling == previousData.upgrades.handling ? 0 : handlingCost) +
        (nextData.upgrades.armor == previousData.upgrades.armor ? 0 : armorCost);
      let increasedCount =
        (nextData.upgrades.engine == previousData.upgrades.engine ? 0 : 1) +
        (nextData.upgrades.handling == previousData.upgrades.handling ? 0 : 1) +
        (nextData.upgrades.armor == previousData.upgrades.armor ? 0 : 1);
      return nextData.money <= previousData.money + 4000
        && nextData.bestDistance >= previousData.bestDistance
        && nextData.bestDistance <= previousData.bestDistance + 2200
        && nextData.upgrades.engine >= previousData.upgrades.engine
        && nextData.upgrades.engine <= previousData.upgrades.engine + 1
        && nextData.upgrades.handling >= previousData.upgrades.handling
        && nextData.upgrades.handling <= previousData.upgrades.handling + 1
        && nextData.upgrades.armor >= previousData.upgrades.armor
        && nextData.upgrades.armor <= previousData.upgrades.armor + 1
        && increasedCount <= 1
        && (
          (requiredSpend == 0 && nextData.money >= previousData.money) ||
          (requiredSpend > 0 && nextData.money <= previousData.money - requiredSpend)
        );
    }

    // User profile + totals doc
    // NOTE: Read is public to preserve existing public leaderboard behavior.
    // If you want stricter privacy later, move leaderboard fields into a separate public collection.
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // Quiz records: strictly per-user access
    match /quiz_records/{recordId} {
      allow create: if signedIn()
        && request.resource.data.user_id == request.auth.uid;
      allow read: if signedIn() && resource.data.user_id == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && resource.data.user_id == request.auth.uid;
    }

    // Daily challenge records: one doc per user/subject/date
    match /daily_challenges/{challengeId} {
      allow create: if signedIn()
        && request.resource.data.user_id == request.auth.uid;
      // resource == null covers the case where the document does not yet exist
      // (e.g. the transaction existence-check reads a not-yet-created document).
      allow read: if signedIn()
        && (resource == null || resource.data.user_id == request.auth.uid);
      allow update: if false;
      allow delete: if false;
    }

    match /monster_siege_progress/{userId} {
      allow read, create, update, delete: if isOwner(userId);
    }

    match /velocity_rush_progress/{userId} {
      allow read, delete: if isOwner(userId);
      allow create: if isOwner(userId)
        && validVelocityProgressData(request.resource.data);
      allow update: if isOwner(userId)
        && validVelocityProgressData(request.resource.data)
        && validVelocityProgressTransition(request.resource.data, resource.data);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
