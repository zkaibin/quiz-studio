{
  "name": "quiz-studio",
  "version": "1.0.0",
  "description": "Fun math quiz generator for primary students with cartoon characters",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "nodemon server/server.js",
    "serve": "node dev-server.js",
    "test:rubik": "node scripts/test-rubiks-core.js",
    "migrate:preflight": "node scripts/preflight-supabase-migration.js",
    "migrate:auth:firebase": "node scripts/migrate-auth-users-to-firebase.js",
    "migrate:supabase:firebase": "node scripts/migrate-supabase-to-firebase.js",
    "firebase:deploy:rules": "firebase deploy --only firestore:rules,storage",
    "firebase:deploy:indexes": "firebase deploy --only firestore:indexes",
    "firebase:deploy:security": "firebase deploy --only firestore:rules,firestore:indexes,storage"
  },
  "keywords": [
    "quiz",
    "math",
    "education",
    "kids"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "firebase-admin": "^14.1.0",
    "nodemon": "^3.0.1"
  }
}
